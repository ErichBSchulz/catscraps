pattern = re.compile(
    r"===\s+.*?openrouter-(.*?)\s+===\n\s+pass_rate_1:\s+([\d.]+)\n\s+pass_rate_2:\s+([\d.]+)\n\s+total_cost:\s+([\d.]+)"
)

# Read run1.txt
